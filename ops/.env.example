# Kamui Cloud Mobile Workspace MVP - Environment Configuration
# Copy to .env and customize

# Required: Shared secret for API authentication
# Generate with: openssl rand -hex 32
KAMUI_TOKEN=dev-change-me-in-production

# Required: Admin password for console login
# Generate with: openssl rand -base64 16
KAMUI_ADMIN_PASSWORD=changeme

# Optional: Tailscale for remote access
# Get auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=

# Optional: GitHub token for private repos (used in repository URLs)
# Format: https://<TOKEN>@github.com/user/repo.git
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Server configuration
API_PORT=8080
CONSOLE_PORT=3000
WORKSPACE_PROXY_PORT=8081

# Workspace defaults
DEFAULT_WORKSPACE_CPU=2
DEFAULT_WORKSPACE_MEMORY=4g
DEFAULT_WORKSPACE_DISK=10g