# start-kamui.ps1 initializes missing credentials in ops/.env.
# For manual setup, generate a different value for each with openssl rand -hex 32.
KAMUI_TOKEN=
KAMUI_ADMIN_PASSWORD=

# Loopback by default. Set to one trusted physical LAN adapter's private IPv4
# address only when you intend to make Kamui reachable on that interface.
KAMUI_BIND_IP=127.0.0.1
KAMUI_PORT=8081
