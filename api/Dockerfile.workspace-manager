FROM golang:1.26.11-alpine AS builder
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/workspace-manager ./cmd/workspace-manager

FROM alpine:3.24
COPY --from=builder /out/workspace-manager /usr/local/bin/kamui-workspace-manager
EXPOSE 8082
ENTRYPOINT ["kamui-workspace-manager"]
